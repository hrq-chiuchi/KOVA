{
  "sections": {
    "intro": {
      "type": "composition",
      "blocks": {
        "split": {
          "type": "kova-layout",
          "settings": { "arrangement": "split-wide-first", "spacing": "open", "alignment": "end" },
          "blocks": {
            "copy": {
              "type": "kova-layout",
              "settings": { "arrangement": "stack", "spacing": "standard", "alignment": "start" },
              "blocks": {
                "eyebrow": {
                  "type": "kova-eyebrow",
                  "settings": { "text": "KOVA", "count_collection": "drop-001", "count_label": "objects in Drop 001" }
                },
                "heading": {
                  "type": "kova-heading",
                  "settings": { "text": "<p>{{ closest.page.title }}</p>", "level": "h1", "size": "display", "accent_last_line": false, "reveal": true }
                },
                "lead": {
                  "type": "kova-text",
                  "settings": {
                    "text": "<p>Every KOVA product page lists the objects it works with, from carry platforms to the small tools that clip to them.</p>",
                    "width": "reading",
                    "size": "lead",
                    "muted": true
                  }
                }
              },
              "block_order": ["eyebrow", "heading", "lead"]
            },
            "record": {
              "type": "kova-record",
              "settings": { "title": "System record", "lines": "", "limit": 8 },
              "blocks": {
                "release": { "type": "_kova-record-row", "settings": { "label": "Release", "value": "Drop 001" } },
                "standard": { "type": "_kova-record-row", "settings": { "label": "Attachment", "value": "Relay Grid" } }
              },
              "block_order": ["release", "standard"]
            }
          },
          "block_order": ["copy", "record"]
        }
      },
      "block_order": ["split"],
      "settings": { "tone": "dark", "accent": "#dfff00", "width": "contained", "spacing": "compact" }
    },
    "platforms": {
      "type": "composition",
      "blocks": {
        "stack": {
          "type": "kova-layout",
          "settings": { "arrangement": "stack", "spacing": "open", "alignment": "start" },
          "blocks": {
            "header": {
              "type": "kova-layout",
              "settings": { "arrangement": "split-even", "spacing": "open", "alignment": "end" },
              "blocks": {
                "heading_group": {
                  "type": "kova-layout",
                  "settings": { "arrangement": "stack", "spacing": "tight", "alignment": "start" },
                  "blocks": {
                    "eyebrow": { "type": "kova-eyebrow", "settings": { "text": "Carry platforms" } },
                    "heading": {
                      "type": "kova-heading",
                      "settings": { "text": "<p>One grid</p><p>many loads</p>", "level": "h2", "size": "title", "accent_last_line": true, "reveal": true }
                    }
                  },
                  "block_order": ["eyebrow", "heading"]
                },
                "text": {
                  "type": "kova-text",
                  "settings": {
                    "text": "<p>Carry Systems are built on the Relay Grid attachment standard. The Gridlink Pouch Array is listed as working with each of these three.</p>",
                    "width": "narrow",
                    "size": "body",
                    "muted": true
                  }
                }
              },
              "block_order": ["heading_group", "text"]
            },
            "products": {
              "type": "kova-layout",
              "settings": { "arrangement": "columns-3", "spacing": "standard", "alignment": "start" },
              "blocks": {
                "backpack": { "type": "kova-product", "settings": { "product": "after-dark-utility-backpack", "heading_tag": "h3" } },
                "courier": { "type": "kova-product", "settings": { "product": "lowlight-courier-14", "heading_tag": "h3" } },
                "hip_rig": { "type": "kova-product", "settings": { "product": "driftline-hip-rig", "heading_tag": "h3" } }
              },
              "block_order": ["backpack", "courier", "hip_rig"]
            }
          },
          "block_order": ["header", "products"]
        }
      },
      "block_order": ["stack"],
      "settings": { "tone": "inverse", "accent": "#dfff00", "width": "contained", "spacing": "standard" }
    },
    "main": {
      "type": "page",
      "settings": { "show_title": false }
    }
  },
  "order": ["intro", "platforms", "main"]
}
