                  "settings": { "arrangement": "stack", "spacing": "tight", "alignment": "start" },
                  "blocks": {
                    "title": { "type": "kova-heading", "settings": { "text": "<p>01 / Built for the night</p>", "level": "h3", "size": "statement", "accent_last_line": false, "reveal": false } },
                    "text": { "type": "kova-text", "settings": { "text": "<p>Weather-resistant shells, reflective details and glove-friendly pulls. Each object is specified for rain, cold and low light before anything else.</p>", "width": "narrow", "size": "body", "muted": true } }
                  },
                  "block_order": ["title", "text"]
                },
                "system": {
                  "type": "kova-layout",
                  "settings": { "arrangement": "stack", "spacing": "tight", "alignment": "start" },
                  "blocks": {
                    "title": { "type": "kova-heading", "settings": { "text": "<p>02 / One system</p>", "level": "h3", "size": "statement", "accent_last_line": false, "reveal": false } },
                    "text": { "type": "kova-text", "settings": { "text": "<p>Carry platforms share the Relay Grid attachment standard, so pouches, flasks and signal lights move between them. Every product page lists what it works with.</p>", "width": "narrow", "size": "body", "muted": true } }
                  },
                  "block_order": ["title", "text"]
                },
                "runs": {
                  "type": "kova-layout",
                  "settings": { "arrangement": "stack", "spacing": "tight", "alignment": "start" },
                  "blocks": {
                    "title": { "type": "kova-heading", "settings": { "text": "<p>03 / Released in runs</p>", "level": "h3", "size": "statement", "accent_last_line": false, "reveal": false } },
                    "text": { "type": "kova-text", "settings": { "text": "<p>Objects arrive in numbered drops. Limited editions carry a fixed unit count and are not reissued once a size closes.</p>", "width": "narrow", "size": "body", "muted": true } }
                  },
                  "block_order": ["title", "text"]
                }
