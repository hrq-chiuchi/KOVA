                "heading": {
                  "type": "kova-heading",
                  "settings": { "text": "<p>Supply for</p><p>after dark</p>", "level": "h1", "size": "display", "accent_last_line": false, "reveal": true }
                },
                "lead": {
                  "type": "kova-text",
                  "settings": {
                    "text": "<p>KOVA makes apparel and carry equipment for people who move through the city at night: late shifts, last trains, rain and low light. Every object is released in a numbered drop and built to work with the others.</p>",
                    "width": "reading",
                    "size": "lead",
                    "muted": true
                  }
                }
