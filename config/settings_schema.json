[
  {
    "name": "theme_info",
    "theme_name": "Afterdark Supply",
    "theme_version": "1.0.0",
    "theme_author": "Afterdark Supply",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_display_font",
        "default": "work_sans_n7",
        "label": "Display font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Maximum page width",
        "options": [
          { "value": "90rem", "label": "Narrow" },
          { "value": "112rem", "label": "Wide" }
        ],
        "default": "112rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 48,
        "step": 4,
        "unit": "px",
        "label": "Minimum page margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#080808",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#f4f3ed",
        "label": "Foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#dfff00",
        "label": "Signal accent"
      }
    ]
  }
]
