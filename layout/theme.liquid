<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% render 'page-transition', part: 'head' %}
    {% render 'entry-signal', part: 'head' %}

    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'motion-core.js' | asset_url }}" defer></script>
    <script src="{{ 'kinetic-hero.js' | asset_url }}" defer></script>
    <script src="{{ 'webgl-product-reveal.js' | asset_url }}" defer></script>
    <script src="{{ 'loadout-verdict.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body>
    {% render 'entry-signal', part: 'body' %}
    {% render 'signal-filters' %}
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% sections 'header-group' %}
    {% section 'cart-drawer' %}

    <main id="MainContent" tabindex="-1">
      {% if request.page_type == 'policy' %}
        {%- comment -%} Store policies have no theme template, so the layout frames them (D-053). {%- endcomment -%}
        {% render 'legal-page', content: content_for_layout %}
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    <canvas class="webgl-reveal-canvas" data-webgl-reveal-canvas aria-hidden="true"></canvas>
    {% sections 'footer-group' %}
    {% render 'page-transition', part: 'body' %}
  </body>
</html>
