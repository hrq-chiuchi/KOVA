{%- liquid
  # Empty collections (such as the admin's "Home page") are left out. The `all` smart collection is the
  # Equipment Index, so it is offered as the masthead link instead of a card with a borrowed image.
  assign listed_count = 0
  for collection in collections
    if collection.products_count > 0 and collection.handle != 'all'
      assign listed_count = listed_count | plus: 1
    endif
  endfor
-%}

<section class="collections-page full-width">
  <div class="collections-page__inner section-shell">
    <div data-motion-scope>
      <header class="collections-page__masthead" data-reveal="section">
        <p class="eyebrow">{{ section.settings.eyebrow | escape }} / {{ listed_count }} collections</p>
        {% render 'display-heading', text: section.settings.heading, class: 'section-heading', tag: 'h1' %}
        {% if section.settings.show_index_link %}
          <a class="collections-page__index-link" href="{{ routes.all_products_collection_url }}">
            <span>Equipment Index / {{ collections.all.products_count }} objects</span><span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </header>
    </div>

    <ol class="collections-page__grid" data-motion-scope>
      {% assign card_index = 0 %}
      {% for collection in collections %}
        {% if collection.products_count == 0 or collection.handle == 'all' %}{% continue %}{% endif %}
        {% assign card_index = card_index | plus: 1 %}
        <li class="collections-page__item" data-reveal-card>
          <a class="collections-page__card" href="{{ collection.url }}">
            <div class="collections-page__media">
              {% if collection.featured_image %}
                {{ collection.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '360, 540, 720, 960, 1200',
                    sizes: '(max-width: 767px) 50vw, 25vw',
                    loading: 'lazy',
                    alt: ''
                }}
              {% else %}
                {% render 'media-pending', title: collection.title, compact: true %}
              {% endif %}
              <span class="collections-page__index" aria-hidden="true">{{ card_index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
            <div class="collections-page__details">
              <h2 class="collections-page__title">{{ collection.title | escape }}</h2>
              <p class="collections-page__count">{{ collection.products_count }} objects</p>
            </div>
            {% if collection.description != blank %}
              <p class="collections-page__description">{{ collection.description | strip_html | truncatewords: 18 }}</p>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% stylesheet %}
  .collections-page { background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); }
  .collections-page__inner { padding-block: var(--ad-space-700) var(--ad-section-space); }
  .collections-page__masthead { display: grid; min-height: 18rem; padding-block-end: var(--ad-space-600); align-content: end; justify-items: start; border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); }
  .collections-page__masthead .section-heading { margin: var(--ad-space-200) 0 0; font-size: var(--ad-text-display); }
  .collections-page__index-link { display: inline-flex; min-height: var(--ad-control-minimum); margin-block-start: var(--ad-space-400); align-items: center; gap: var(--ad-space-100); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; }
  .collections-page__index-link span:first-child { border-block-end: var(--ad-border-hairline) solid currentcolor; }
  .collections-page__grid { display: grid; margin: 0; padding: var(--ad-space-600) 0 0; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--ad-space-600) clamp(0.75rem, 2vw, 2rem); list-style: none; }
  .collections-page__card { display: grid; gap: var(--ad-space-200); color: inherit; text-decoration: none; }
  .collections-page__media { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: var(--ad-color-background-elevated); }
  .collections-page__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform var(--ad-duration-base) var(--ad-ease-standard); }
  .collections-page__index { position: absolute; inset-block-start: var(--ad-space-300); inset-inline-start: var(--ad-space-300); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; }
  .collections-page__details { display: flex; padding-block: var(--ad-space-100) var(--ad-space-200); align-items: start; justify-content: space-between; gap: var(--ad-space-200); border-block-end: var(--ad-border-hairline) solid color-mix(in srgb, currentcolor 24%, transparent); }
  .collections-page__title { margin: 0; font-size: var(--ad-text-body); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .collections-page__count { margin: 0; flex-shrink: 0; color: var(--ad-color-text-muted); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .collections-page__description { max-width: 32rem; margin: 0; color: var(--ad-color-text-muted); }
  .collections-page__card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @media (hover: hover) {
    .collections-page__card:hover .collections-page__media img { transform: scale(1.03); }
    .collections-page__card:hover .collections-page__title { color: var(--color-accent); }
  }
  @media (max-width: 63.99rem) {
    .collections-page__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 47.99rem) {
    .collections-page__inner { padding-block-start: var(--ad-space-500); }
    .collections-page__masthead { min-height: 12rem; }
    /* "Collections" is a long single word; the shared display size overflows a phone. */
    .collections-page__masthead .section-heading { font-size: clamp(2.75rem, 13vw, 4.25rem); }
    .collections-page__grid { padding-block-start: var(--ad-space-400); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ad-space-500) var(--ad-space-100); }
    .collections-page__details { display: grid; gap: var(--ad-space-50); }
    .collections-page__description { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .collections-page__media img { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KOVA" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "checkbox", "id": "show_index_link", "label": "Link to the Equipment Index", "default": true }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}
