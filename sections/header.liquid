<afterdark-header
  class="site-header full-width"
  data-overlay="{% if request.page_type == 'index' %}true{% else %}false{% endif %}"
  data-cart-json-url="{{ routes.cart_url }}.js"
>
  <div class="site-header__inner">
    <div class="site-header__left">
      <button
        class="site-header__menu-button"
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-controls="SiteMenu-{{ section.id }}"
      >
        <span aria-hidden="true">☰</span> Menu
      </button>
      {% if section.settings.menu != blank %}
        {%- comment -%}
          Top-level items stay real links. An item with children also gets a disclosure toggle, shown
          only when JavaScript runs, that opens a full-width panel; without JavaScript the parent link
          goes to its collection. Only the first three top-level items fit the bar.
        {%- endcomment -%}
        <nav class="site-header__nav" aria-label="Primary navigation" data-mega-nav>
          {% for link in section.settings.menu.links limit: 3 %}
            {% assign panel_position = forloop.index | append: '' %}
            <div class="site-header__nav-item" data-mega-item>
              {%- comment -%} A `#` placeholder URL is a group label, not a destination. {%- endcomment -%}
              {% if link.url == '#' %}
                <span class="site-header__nav-label"{% if link.links != blank %} data-mega-label{% endif %}>{{ link.title | escape }}</span>
              {% else %}
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% endif %}
              {% if link.links != blank %}
                <button
                  class="site-header__nav-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls="MegaPanel-{{ section.id }}-{{ forloop.index }}"
                  data-mega-toggle
                  hidden
                >
                  <span class="visually-hidden">{{ link.title | escape }} menu</span>
                  <span aria-hidden="true">+</span>
                </button>
                <div id="MegaPanel-{{ section.id }}-{{ forloop.index }}" class="mega-panel" data-mega-panel hidden>
                  <div class="mega-panel__inner">
                    <ul class="mega-panel__columns" role="list">
                      {% for child in link.links %}
                        <li class="mega-panel__column">
                          {% if child.links != blank %}
                            <a class="mega-panel__heading" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                            <ul class="mega-panel__list" role="list">
                              {% for grandchild in child.links %}
                                <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                              {% endfor %}
                            </ul>
                          {% else %}
                            <a class="mega-panel__link" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                              <span>{{ child.title | escape }}</span><span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
                            </a>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                    {% for block in section.blocks %}
                      {% if block.type == 'featured' and block.settings.panel == panel_position %}
                        <a class="mega-panel__featured" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>
                          <span class="mega-panel__featured-media">
                            {% if block.settings.image != blank %}
                              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 62rem) 24rem, 100vw', loading: 'lazy', alt: block.settings.image.alt | default: '' }}
                            {% endif %}
                          </span>
                          {% if block.settings.eyebrow != blank %}
                            <span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>
                          {% endif %}
                          <span class="mega-panel__featured-title">{{ block.settings.title | escape }}</span>
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </nav>
      {% endif %}
    </div>

    <a class="site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 500 | image_tag: widths: '180, 260, 360, 500', sizes: section.settings.logo_width | append: 'px', loading: 'eager', alt: shop.name }}
      {% else %}
        <span>{{ section.settings.brand_mark | default: shop.name | escape }}</span>
      {% endif %}
    </a>

    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <a
          class="site-header__utility site-header__search"
          href="{{ routes.search_url }}"
          data-search-open
          aria-controls="SearchCommand-{{ section.id }}"
        >
          {{- 'search.title' | t -}}
          <kbd class="site-header__key" aria-hidden="true">/</kbd>
        </a>
      {% endif %}
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          <span class="visually-hidden">Account</span>
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}
      <a class="site-header__cart" href="{{ routes.cart_url }}" data-cart-open>
        <span>Bag</span>
        <span class="site-header__cart-count" data-cart-count aria-label="{{ cart.item_count }} items">{{ cart.item_count | prepend: '0' | slice: -2, 2 }}</span>
      </a>
    </div>
  </div>

  <dialog id="SiteMenu-{{ section.id }}" class="site-menu" data-menu-dialog scroll-lock aria-labelledby="SiteMenuTitle-{{ section.id }}">
    <div class="site-menu__panel">
      <div class="site-menu__top">
        <p id="SiteMenuTitle-{{ section.id }}" class="eyebrow">KOVA / Navigation</p>
        <button class="site-menu__close" type="button" data-menu-close>Close</button>
      </div>
      <nav class="site-menu__nav" aria-label="Menu navigation">
        {%- comment -%}
          Items with children are native disclosures, so they work with the keyboard and without
          JavaScript. The parent link stays reachable as the first entry of its group.
        {%- endcomment -%}
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            <details class="site-menu__group"{% if link.child_active %} open{% endif %}>
              <summary class="site-menu__link">
                <span>{{ link.title | escape }}</span><span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
              </summary>
              <ul class="site-menu__sublist" role="list">
                {% unless link.url == '#' %}
                  <li>
                    <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                      View all<span class="visually-hidden"> {{ link.title | escape }}</span>
                    </a>
                  </li>
                {% endunless %}
                {% for child in link.links %}
                  <li>
                    <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    {% if child.links != blank %}
                      <ul class="site-menu__sublist site-menu__sublist--nested" role="list">
                        {% for grandchild in child.links %}
                          <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% else %}
            <a class="site-menu__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
              <span>{{ link.title | escape }}</span><span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            </a>
          {% endif %}
        {% else %}
          <a class="site-menu__link" href="{{ routes.all_products_collection_url }}"><span>Equipment Index</span><span aria-hidden="true">01</span></a>
          <a class="site-menu__link" href="{{ routes.search_url }}"><span>Search</span><span aria-hidden="true">02</span></a>
        {% endfor %}
      </nav>
      <div class="site-menu__utility">
        <p>{{ section.settings.menu_note | escape }}</p>
        <a href="{{ routes.search_url }}">Search the index ↗</a>
      </div>
    </div>
  </dialog>

  {% if section.settings.show_search %}
    <dialog
      id="SearchCommand-{{ section.id }}"
      class="search-command"
      data-search-dialog
      data-module-url="{{ 'search-command.js' | asset_url }}"
      aria-label="{{ 'search.command.label' | t }}"
    >
      <kova-search
        class="search-command__panel"
        data-url="{{ routes.predictive_search_url }}"
        data-status-one="{{ 'search.command.status_one' | t }}"
        data-status-other="{{ 'search.command.status_other' | t: count: '[count]' }}"
        data-status-none="{{ 'search.command.status_none' | t }}"
      >
        <form class="search-command__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="SearchCommandInput-{{ section.id }}">{{ 'search.command.label' | t }}</label>
          <input
            id="SearchCommandInput-{{ section.id }}"
            class="search-command__input"
            type="search"
            name="q"
            autocomplete="off"
            spellcheck="false"
            placeholder="{{ 'search.placeholder' | t }}"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="SearchCommandResults-{{ section.id }}"
            data-search-input
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button class="search-command__close" type="button" data-search-close>{{ 'search.command.close' | t }}</button>
        </form>
        <div
          id="SearchCommandResults-{{ section.id }}"
          class="search-command__results"
          role="listbox"
          aria-label="{{ 'search.command.results_label' | t }}"
          data-search-results
        ></div>
        <p class="search-command__hint" aria-hidden="true">{{ 'search.command.hint' | t }}</p>
        <p class="visually-hidden" role="status" data-search-status></p>
      </kova-search>
    </dialog>
  {% endif %}
</afterdark-header>

{% stylesheet %}
  .site-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    display: block;
    height: var(--ad-header-height);
    border-block-end: var(--ad-border-hairline) solid transparent;
    background: rgb(8 8 8 / 88%);
    color: var(--ad-color-text-primary);
    backdrop-filter: blur(18px);
    transform: translateY(var(--ad-header-shift, 0px));
    transition: background-color var(--ad-duration-fast) var(--ad-ease-standard), border-color var(--ad-duration-fast) var(--ad-ease-standard);
  }

  /* Without JavaScript the header cannot track the announcement bar, so it sits below it and scrolls away. */
  html:not(.js) body:has([data-announcement]) .site-header { position: absolute; top: auto; }
  .site-header[data-overlay='true']:not([data-scrolled]) { background: transparent; backdrop-filter: none; }
  .site-header[data-scrolled],
  .site-header[data-overlay='false'] { border-color: var(--ad-color-border-subtle); }
  .site-header a { color: inherit; text-decoration: none; }

  .site-header__inner {
    display: grid;
    width: min(100% - (2 * var(--ad-page-padding)), var(--ad-container-width));
    height: 100%;
    margin-inline: auto;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--ad-space-400);
  }

  .site-header__left,
  .site-header__actions,
  .site-header__nav { display: flex; align-items: center; }
  .site-header__left { min-width: 0; gap: var(--ad-space-500); }
  .site-header__actions { justify-content: flex-end; gap: var(--ad-space-300); }
  .site-header__nav { gap: var(--ad-space-400); }

  .site-header__brand {
    display: inline-flex;
    max-width: min(34vw, 20rem);
    justify-self: center;
    font-family: var(--font-display-family);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: var(--font-display-weight);
    letter-spacing: -0.055em;
    line-height: 0.8;
    text-align: center;
    text-transform: uppercase;
  }

  .site-header__brand img { width: auto; max-width: 100%; max-height: calc(var(--ad-header-height) - 1.5rem); }
  .site-header__menu-button,
  .site-header__nav,
  .site-header__utility,
  .site-header__cart {
    font-size: var(--ad-text-label);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .site-header__menu-button,
  .site-menu__close { border: 0; background: transparent; }
  .site-header__menu-button { display: inline-flex; min-height: var(--ad-control-minimum); padding: 0; align-items: center; gap: var(--ad-space-100); }
  .site-header__menu-button span { font-size: 0.9rem; }
  .site-header__nav a,
  .site-header__nav-label,
  .site-header__utility { padding-block: var(--ad-space-200); }
  .site-header shopify-account svg { width: 1.2rem; }
  .site-header__cart { display: flex; align-items: center; gap: var(--ad-space-100); }
  .site-header__cart-count { display: inline-grid; min-width: 1.65rem; min-height: 1.65rem; place-items: center; border-radius: 50%; background: var(--color-accent); color: var(--ad-color-text-inverse); font-size: 0.58rem; }

  .site-menu { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: var(--ad-color-text-primary); }
  .site-menu::backdrop { background: rgb(0 0 0 / 62%); backdrop-filter: blur(5px); }
  .site-menu__panel { display: flex; width: min(46rem, 100%); height: 100%; padding: var(--ad-page-padding); flex-direction: column; background: rgb(16 16 16 / 93%); border-inline-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); backdrop-filter: blur(24px); }
  .site-menu__top { display: flex; min-height: var(--ad-header-height); align-items: center; justify-content: space-between; border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); }
  .site-menu__close { min-width: var(--ad-control-minimum); color: inherit; font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .site-menu__nav { display: flex; margin-block: auto; flex-direction: column; }
  .site-menu__link { display: flex; padding-block: var(--ad-space-300); align-items: center; justify-content: space-between; border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); font-family: var(--font-display-family); font-size: clamp(2.75rem, 7vw, 6.5rem); font-weight: var(--font-display-weight); letter-spacing: -0.06em; line-height: 0.88; text-transform: uppercase; }
  .site-menu__link > span:last-child { font-family: var(--font-primary--family); font-size: var(--ad-text-label); letter-spacing: 0.12em; }
  .site-menu__group summary { cursor: pointer; list-style: none; }
  .site-menu__group summary::-webkit-details-marker { display: none; }
  .site-menu__group[open] > summary > span:last-child { color: var(--color-accent); }
  .site-menu__sublist { display: grid; margin: 0; padding: var(--ad-space-300) 0 var(--ad-space-400); gap: var(--ad-space-100); list-style: none; }
  .site-menu__sublist a { display: inline-flex; min-height: var(--ad-control-minimum); align-items: center; font-size: var(--ad-text-lead); }
  .site-menu__sublist--nested { padding: 0 0 var(--ad-space-100) var(--ad-space-400); }
  .site-menu__sublist--nested a { color: var(--ad-color-text-muted); font-size: var(--ad-text-body); }
  .site-menu__nav { overflow-y: auto; overscroll-behavior: contain; }
  .site-menu__utility { display: flex; padding-block-start: var(--ad-space-400); justify-content: space-between; gap: var(--ad-space-300); border-block-start: var(--ad-border-hairline) solid var(--ad-color-border-subtle); color: var(--ad-color-text-muted); font-size: 0.8rem; }

  .site-header__search { display: inline-flex; align-items: center; gap: var(--ad-space-100); }
  .site-header__key { display: inline-grid; min-width: 1.25rem; min-height: 1.25rem; place-items: center; border: var(--ad-border-hairline) solid var(--ad-color-border-subtle); color: var(--ad-color-text-muted); font-family: inherit; font-size: 0.625rem; }

  .search-command { width: min(52rem, 100% - (2 * var(--ad-page-padding))); max-width: none; max-height: min(44rem, 100dvh - 6rem); margin: clamp(1rem, 10vh, 6rem) auto auto; padding: 0; border: var(--ad-border-hairline) solid var(--ad-color-border-subtle); background: var(--ad-color-background-elevated); color: var(--ad-color-text-primary); }
  .search-command::backdrop { background: rgb(0 0 0 / 70%); backdrop-filter: blur(6px); }
  .search-command[open] { display: flex; }
  .search-command__panel { display: flex; width: 100%; min-height: 0; flex-direction: column; }
  .search-command__form { display: flex; align-items: center; gap: var(--ad-space-300); padding: var(--ad-space-300) var(--ad-space-400); border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); }
  .search-command__input { min-width: 0; min-height: var(--ad-control-minimum); flex: 1; padding: 0; border: 0; background: transparent; color: inherit; font-family: var(--font-display-family); font-size: clamp(1.5rem, 4vw, 2.5rem); font-weight: var(--font-display-weight); letter-spacing: -0.03em; text-transform: uppercase; }
  .search-command__input::placeholder { color: var(--ad-color-text-muted); opacity: 0.6; }
  .search-command__input:focus-visible { outline: none; }
  .search-command__form:focus-within { box-shadow: inset 0 -2px 0 var(--color-accent); }
  .search-command__input::-webkit-search-cancel-button { display: none; }
  .search-command__close { min-height: var(--ad-control-minimum); padding: 0; border: 0; background: transparent; color: inherit; font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .search-command__results { min-height: 0; flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: var(--ad-space-300) var(--ad-space-400); }
  .search-command__results:empty { display: none; }
  .search-command__hint { margin: 0; padding: var(--ad-space-200) var(--ad-space-400); border-block-start: var(--ad-border-hairline) solid var(--ad-color-border-subtle); color: var(--ad-color-text-muted); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .search-command__panel[aria-busy='true'] .search-command__form { box-shadow: inset 0 -2px 0 var(--ad-color-text-muted); }

  .site-header__nav-item { display: flex; align-items: center; gap: var(--ad-space-50); }
  .site-header__nav-toggle { display: inline-grid; min-width: 1.5rem; min-height: var(--ad-control-minimum); padding: 0; place-items: center; border: 0; background: transparent; color: inherit; font: inherit; }
  .site-header__nav-toggle[hidden] { display: none; }
  /* A label opens its panel on click (the toggle stays the keyboard control), so it reads as clickable like the links. */
  .js .site-header__nav-label[data-mega-label] { cursor: pointer; user-select: none; }
  .site-header__nav-toggle > span[aria-hidden] { transition: transform var(--ad-duration-fast) var(--ad-ease-standard); }
  .site-header__nav-toggle[aria-expanded='true'] { color: var(--color-accent); }
  .site-header__nav-toggle[aria-expanded='true'] > span[aria-hidden] { transform: rotate(45deg); }
  .site-header[data-panel-open],
  .site-header[data-overlay='true'][data-panel-open] { border-color: var(--ad-color-border-subtle); background: var(--ad-color-background-primary); }

  /* The header's backdrop-filter makes it the containing block, so the panel is absolute, not fixed. */
  .mega-panel { position: absolute; inset-inline: 0; top: 100%; max-height: calc(100dvh - var(--ad-header-height)); overflow-y: auto; border-block: var(--ad-border-hairline) solid var(--ad-color-border-subtle); background: var(--ad-color-background-primary); text-transform: none; letter-spacing: normal; font-weight: 400; }
  .mega-panel[hidden] { display: none; }
  .mega-panel__inner { display: grid; width: min(100% - (2 * var(--ad-page-padding)), var(--ad-container-width)); margin-inline: auto; padding-block: var(--ad-space-500) var(--ad-space-600); grid-template-columns: minmax(0, 1fr) auto; gap: var(--ad-content-gap); }
  .mega-panel__columns { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); align-content: start; column-gap: var(--ad-space-500); list-style: none; }
  .mega-panel__link { display: flex; padding-block: var(--ad-space-200); align-items: baseline; justify-content: space-between; gap: var(--ad-space-300); border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); font-family: var(--font-display-family); font-size: clamp(1.375rem, 1.8vw, 2rem); font-weight: var(--font-display-weight); letter-spacing: -0.04em; line-height: 0.95; text-transform: uppercase; }
  .mega-panel__link > span:first-child { min-width: 0; overflow-wrap: break-word; }
  .mega-panel__link > span:last-child { flex: none; }
  .mega-panel__link > span:last-child,
  .mega-panel__heading { font-family: var(--font-primary--family); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .mega-panel__link > span:last-child { color: var(--ad-color-text-muted); }
  .mega-panel__heading { display: block; padding-block: var(--ad-space-200); border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); color: var(--ad-color-text-muted); }
  .mega-panel__list { display: grid; margin: 0; padding: var(--ad-space-200) 0 var(--ad-space-400); gap: var(--ad-space-100); list-style: none; }
  .mega-panel__list a { font-size: var(--ad-text-lead); }
  .mega-panel a:hover,
  .mega-panel a[aria-current='page'] { color: var(--color-accent); }
  .mega-panel__featured { display: grid; width: 24rem; align-content: start; gap: var(--ad-space-200); }
  .mega-panel__featured-media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--ad-color-background-elevated); }
  .mega-panel__featured-media img { width: 100%; height: 100%; object-fit: cover; }
  .mega-panel__featured-title { font-family: var(--font-display-family); font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: var(--font-display-weight); letter-spacing: -0.04em; line-height: 0.95; text-transform: uppercase; }

  @media (prefers-reduced-motion: no-preference) {
    .search-command[open] { animation: search-command-in var(--ad-duration-base) var(--ad-ease-standard); }
    .mega-panel:not([hidden]) { animation: search-command-in var(--ad-duration-base) var(--ad-ease-standard); }
    .search-command[open]::backdrop { animation: search-command-fade var(--ad-duration-fast) linear; }
    /* Menu entrance: the panel slides in from its edge, then the links rise in sequence. */
    .site-menu[open]::backdrop { animation: search-command-fade var(--ad-duration-fast) linear; }
    .site-menu[open] .site-menu__panel { animation: site-menu-in var(--ad-duration-base) var(--ad-ease-standard); }
    .site-menu[open] :is(.site-menu__nav > *, .site-menu__utility) { animation: site-menu-item-in var(--ad-duration-base) var(--ad-ease-standard) both; animation-delay: calc(120ms + var(--menu-step, 0) * 45ms); }
    .site-menu__nav > :nth-child(2) { --menu-step: 1; }
    .site-menu__nav > :nth-child(3) { --menu-step: 2; }
    .site-menu__nav > :nth-child(4) { --menu-step: 3; }
    .site-menu__nav > :nth-child(5) { --menu-step: 4; }
    .site-menu__nav > :nth-child(6) { --menu-step: 5; }
    .site-menu__nav > :nth-child(n + 7),
    .site-menu__utility { --menu-step: 6; }
  }

  @keyframes site-menu-in {
    from { transform: translateX(-100%); }
  }

  @keyframes site-menu-item-in {
    from { opacity: 0; transform: translateY(1.25rem); }
  }

  @keyframes search-command-in {
    from { clip-path: inset(0 0 100% 0); opacity: 0; }
    to { clip-path: inset(0 0 0 0); opacity: 1; }
  }

  @keyframes search-command-fade {
    from { opacity: 0; }
  }

  @media (max-width: 61.99rem) {
    .site-header__nav { display: none; }
    .site-header__left { gap: 0; }
  }

  @media (max-width: 34rem) {
    .site-header shopify-account,
    .site-header__key { display: none; }
    .search-command { width: 100%; max-height: 100dvh; margin: 0; border-inline: 0; border-block-start: 0; }
    .search-command__form { padding-inline: var(--ad-page-padding); }
    .search-command__results { padding-inline: var(--ad-page-padding); }
    .search-command__hint { display: none; }
    .site-header__actions { gap: var(--ad-space-100); }
    .site-header__cart > span:first-child { display: none; }
    .site-header__menu-button { font-size: 0; }
    .site-header__menu-button span { font-size: 1rem; }
    .site-menu__utility { display: grid; }
  }
{% endstylesheet %}

