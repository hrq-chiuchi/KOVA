{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<article class="article-page full-width" data-motion-scope>
  <div class="article-page__inner section-shell">
    <header class="article-page__header" data-reveal="section">
      <p class="eyebrow">
        <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
        {% if article.tags.size > 0 %} / {{ article.tags.first | escape }}{% endif %}
      </p>
      {% render 'display-heading', text: article.title, class: 'article-page__title', tag: 'h1' %}
      {% assign date = article.published_at | time_tag: format: 'date' %}
      <p class="article-page__meta">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
    </header>

    {% if article.image %}
      <figure class="article-page__figure">
        {{ article.image
          | image_url: width: 1800
          | image_tag: widths: '720, 1080, 1440, 1800', sizes: '(max-width: 767px) 100vw, 80vw', alt: article.image.alt | default: article.title
        }}
      </figure>
    {% endif %}

    <div class="article-page__body">{{ article.content }}</div>

    <a class="article-page__back" href="{{ blog.url }}"><span aria-hidden="true">←</span> <span>All {{ blog.title | escape }}</span></a>
{% if blog.comments_enabled? %}
  <h2>{{ 'blog.article_comments' | t }}</h2>

  <div id="comments">
    {% paginate article.comments by 10 %}
      {% for comment in article.comments %}
        <div>
          <p>{{ comment.author }}</p>
          <p>
            {{- comment.created_at | time_tag: format: 'date' -}}
          </p>
          <p>{{ comment.content }}</p>
        </div>
      {% endfor %}

      {{ paginate | default_pagination: anchor: 'comments' }}
    {% endpaginate %}
  </div>

  {% form 'new_comment', article %}
    <h2>{{ 'blog.comment_form_title' | t }}</h2>

    {{ form.errors | default_errors }}

    <div>
      <label for="author">{{ 'blog.comment_form_name' | t }}</label>
      <input type="text" name="comment[author]" id="author" value="{{ form.author }}" required>
    </div>

    <div>
      <label for="email">{{ 'blog.comment_form_email' | t }}</label>
      <input type="email" name="comment[email]" id="email" value="{{ form.email }}" required>
    </div>

    <div>
      <label for="body">{{ 'blog.comment_form_body' | t }}</label>
      <textarea name="comment[body]" id="body" required>{{ form.body }}</textarea>
    </div>

    <input type="submit" value="{{ 'blog.comment_form_submit' | t }}">
  {% endform %}
{% endif %}
  </div>
</article>

{% stylesheet %}
  .article-page { background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); }
  .article-page__inner { padding-block: var(--ad-space-500) var(--ad-section-space); }
  .article-page__header { max-width: 60rem; margin-block-end: var(--ad-space-700); }
  .article-page__header .eyebrow a { text-decoration: none; }
  .article-page__title { margin: var(--ad-space-300) 0 0; font-family: var(--font-display-family); font-size: var(--ad-text-title); font-weight: var(--font-display-weight); letter-spacing: -0.055em; line-height: 0.9; text-transform: uppercase; }
  .article-page__meta { margin: var(--ad-space-400) 0 0; color: var(--ad-color-text-muted); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .article-page__figure { margin: 0 0 var(--ad-space-700); }
  .article-page__figure img { display: block; width: 100%; height: auto; }
  .article-page__body { max-width: 40rem; margin-inline-start: clamp(0rem, 16vw, 18rem); font-size: var(--ad-text-lead); line-height: 1.6; }
  .article-page__body > * { margin: 0; }
  .article-page__body > * + * { margin-block-start: var(--ad-space-400); }
  .article-page__body > p:first-child { font-size: clamp(1.375rem, 2.2vw, 1.875rem); line-height: 1.35; }
  .article-page__back { display: inline-flex; min-height: var(--ad-control-minimum); margin-block-start: var(--ad-space-700); align-items: center; gap: var(--ad-space-200); border-block-end: var(--ad-border-hairline) solid currentcolor; font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.14em; text-decoration: none; text-transform: uppercase; }

  @media (max-width: 47.99rem) {
    .article-page__body { margin-inline-start: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": []
}
{% endschema %}
