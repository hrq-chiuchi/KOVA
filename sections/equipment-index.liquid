{%- liquid
  assign layout = section.settings.layout
  assign index_view = 'index'
  assign other_view = 'index-grid'
  if layout == 'grid'
    assign index_view = 'index-grid'
    assign other_view = 'index'
  endif
  # The rows/grid switch is two alternate templates (`?view=`), so it works without JavaScript.
  # Liquid cannot read the query string, so the current filters are rebuilt from the filter objects.
  capture current_query
    assign current_sort = collection.sort_by | default: collection.default_sort_by
    echo 'sort_by=' | append: current_sort
    for filter in collection.filters
      if filter.type == 'price_range'
        if filter.min_value.value != null
          assign price_value = filter.min_value.value | money_without_currency | replace: ',', ''
          echo '&' | append: filter.min_value.param_name | append: '=' | append: price_value
        endif
        if filter.max_value.value != null
          assign price_value = filter.max_value.value | money_without_currency | replace: ',', ''
          echo '&' | append: filter.max_value.param_name | append: '=' | append: price_value
        endif
      else
        for value in filter.active_values
          assign encoded_value = value.value | url_encode
          echo '&' | append: value.param_name | append: '=' | append: encoded_value
        endfor
      endif
    endfor
  endcapture
  assign view_param = blank
  if collection.template_suffix != index_view
    assign view_param = index_view
  endif
  assign other_url = collection.url | append: '?' | append: current_query | append: '&view=' | append: other_view
  if collection.template_suffix == other_view
    assign other_url = collection.url | append: '?' | append: current_query
  endif
-%}

<section class="equipment-index full-width">
  <div class="equipment-index__inner section-shell">
    {% if section.settings.show_masthead %}
      <div data-motion-scope>
        <header class="equipment-index__masthead" data-reveal="section">
          <p class="eyebrow">{{ section.settings.eyebrow | escape }} / <span class="equipment-index__total">{{ collection.all_products_count }}</span> objects</p>
          {% render 'display-heading', text: section.settings.heading, class: 'section-heading', tag: 'h1' %}
          {% if collection.description != blank %}<div class="equipment-index__description">{{ collection.description }}</div>{% endif %}
        </header>
      </div>
    {% endif %}

    {% paginate collection.products by 48 %}
      <index-filters class="equipment-index__layout" data-section-id="{{ section.id }}">
        <aside class="equipment-index__tools" aria-label="Filter the index">
          {% render 'index-filters', results: collection, url: collection.url, count: collection.products_count, view: view_param, id_prefix: section.id %}
        </aside>

        <div class="equipment-index__results" data-filters-swap="results" data-motion-scope>
          <nav class="equipment-index__views" aria-label="Index view">
            {% if layout == 'rows' %}
              <span aria-current="page">Index</span>
              <a href="{{ other_url }}">Grid</a>
            {% else %}
              <a href="{{ other_url }}">Index</a>
              <span aria-current="page">Grid</span>
            {% endif %}
          </nav>

          {% if collection.products_count > 0 %}
            {% if layout == 'rows' %}
              <div class="index-rows__head" aria-hidden="true">
                <span>No.</span><span></span><span>Object</span><span>Type</span><span>System</span><span>Status</span><span>Price</span>
              </div>
              <ol class="index-rows">
                {% for product in collection.products %}
                  {% assign row_index = paginate.current_offset | plus: forloop.index %}
                  {% render 'index-row', product: product, index: row_index %}
                {% endfor %}
              </ol>
            {% else %}
              <div class="equipment-index__grid">
                {% for product in collection.products %}
                  {% assign card_index = paginate.current_offset | plus: forloop.index %}
                  {% render 'product-card', product: product, index: card_index, sizes: '(max-width: 767px) 50vw, 25vw', quick_add: true, heading_tag: 'h2' %}
                {% endfor %}
              </div>
            {% endif %}
          {% else %}
            <div class="equipment-index__empty">
              <p>No objects match this view.</p>
              <a class="button" href="{{ collection.url }}{% if view_param != blank %}?view={{ view_param }}{% endif %}" data-filters-link>Reset index</a>
            </div>
          {% endif %}

          {% if paginate.pages > 1 %}
            <nav class="equipment-index__pagination" aria-label="Index pages">{{ paginate | default_pagination }}</nav>
          {% endif %}
        </div>
      </index-filters>
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  .equipment-index { background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); }
  .equipment-index__inner { padding-block: var(--ad-space-700) var(--ad-section-space); }
  .equipment-index__masthead { display: grid; min-height: 18rem; padding-block-end: var(--ad-space-600); align-content: end; border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); }
  .equipment-index__masthead .section-heading { margin: var(--ad-space-200) 0 0; font-size: min(var(--ad-text-display), 14vw); }
  .equipment-index__total { font-variant-numeric: tabular-nums; }
  .equipment-index__description { max-width: 42rem; margin-block-start: var(--ad-space-400); color: var(--ad-color-text-muted); }
  .equipment-index__layout { display: grid; grid-template-columns: minmax(14rem, 0.45fr) minmax(0, 2fr); gap: var(--ad-content-gap); padding-block-start: var(--ad-space-600); }
  .equipment-index__tools { max-height: calc(100vh - var(--ad-header-height) - var(--ad-space-500)); align-self: start; position: sticky; top: calc(var(--ad-header-height) + var(--ad-space-300)); overflow-y: auto; overscroll-behavior: contain; }
  .equipment-index__results { min-width: 0; }
  .equipment-index__views { display: flex; min-height: var(--ad-control-minimum); margin-block-end: var(--ad-space-300); align-items: center; justify-content: flex-end; gap: var(--ad-space-300); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .equipment-index__views a { color: var(--ad-color-text-muted); text-decoration: none; }
  .equipment-index__views a:hover { color: var(--ad-color-text-primary); }
  .equipment-index__views [aria-current] { color: var(--color-accent); }
  .equipment-index__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ad-space-600) clamp(0.75rem, 2vw, 2rem); }
  .equipment-index__pagination { display: flex; margin-block-start: var(--ad-space-700); justify-content: center; }
  .equipment-index__pagination .pagination { display: flex; gap: var(--ad-space-200); }
  .equipment-index__empty { display: grid; min-height: 24rem; place-content: center; justify-items: center; gap: var(--ad-space-300); }

  @media (max-width: 47.99rem) {
    .equipment-index__inner { padding-block-start: var(--ad-space-500); }
    .equipment-index__masthead { min-height: 12rem; }
    .equipment-index__layout { grid-template-columns: 1fr; padding-block-start: var(--ad-space-400); }
    .equipment-index__tools { max-height: none; position: static; overflow: visible; }
    .equipment-index__views { margin-block-end: var(--ad-space-100); }
    .equipment-index__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ad-space-500) var(--ad-space-100); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Equipment Index",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "View",
      "options": [
        { "value": "rows", "label": "Index rows" },
        { "value": "grid", "label": "Product grid" }
      ],
      "default": "rows",
      "info": "The rows template (collection.index) and the grid template (collection.index-grid) link to each other."
    },
    { "type": "checkbox", "id": "show_masthead", "label": "Show masthead", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KOVA" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Equipment\nIndex", "info": "Each line reveals separately." }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
