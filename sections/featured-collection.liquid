{% liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.product_limit
%}

<product-rail
  class="featured-collection full-width"
  style="--section-background: {{ section.settings.background }}; --section-foreground: {{ section.settings.foreground }}; --section-accent: {{ section.settings.accent }};"
  data-motion-scope
>
  <div class="featured-collection__header section-shell" data-reveal="section">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="section-heading"><span data-reveal-line-wrap><span data-reveal-line>{{ section.settings.heading | escape }}</span></span></h2>
    </div>
    <div class="featured-collection__controls">
      <button class="icon-button" type="button" data-rail-previous aria-label="Previous products">
        <span aria-hidden="true">←</span>
      </button>
      <button class="icon-button" type="button" data-rail-next aria-label="Next products">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <div
    class="featured-collection__track"
    data-rail-track
    role="region"
    aria-label="{{ section.settings.heading | escape }}"
    tabindex="0"
  >
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      {% for product in featured_collection.products limit: product_limit %}
        {% render 'product-card', product: product, index: forloop.index, sizes: '(min-width: 990px) 38vw, 78vw' %}
      {% endfor %}
    {% else %}
      {% for i in (1..product_limit) %}
        {% assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 %}
        {% assign placeholder_name = 'product-' | append: placeholder_index %}
        <article class="product-card" data-reveal-card>
          <div class="product-card__media">
            {{ placeholder_name | placeholder_svg_tag: 'product-card__placeholder' }}
            <span class="product-card__index" aria-hidden="true">{{ i | prepend: '0' | slice: -2, 2 }}</span>
          </div>
          <div class="product-card__details">
            <h3 class="product-card__title">Night object {{ i }}</h3>
            <p class="product-card__price">{{ 12000 | times: i | money }}</p>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>

  {% if section.settings.collection != blank %}
    <div class="featured-collection__footer section-shell">
      <a class="button" href="{{ featured_collection.url }}">{{ section.settings.link_label | escape }}</a>
    </div>
  {% endif %}
</product-rail>

{% stylesheet %}
  .featured-collection {
    display: block;
    overflow: clip;
    padding-block: var(--ad-section-space);
    background: var(--section-background);
    color: var(--section-foreground);
  }

  .featured-collection__header {
    display: flex;
    margin-block-end: var(--ad-space-700);
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--ad-space-500);
  }

  .featured-collection__header .eyebrow {
    margin-block-end: var(--ad-space-300);
    color: var(--section-accent);
  }

  .featured-collection__controls {
    display: none;
    gap: var(--ad-space-100);
  }

  product-rail:defined .featured-collection__controls {
    display: flex;
  }

  .featured-collection__controls button:disabled {
    cursor: default;
    opacity: 0.3;
  }

  .featured-collection__track {
    display: grid;
    grid-auto-columns: clamp(18rem, 38vw, 43rem);
    grid-auto-flow: column;
    gap: clamp(1rem, 2vw, 2rem);
    padding-inline: max(var(--ad-page-padding), calc((100vw - var(--ad-container-width)) / 2));
    padding-block-end: var(--ad-space-400);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--ad-page-padding);
    scroll-snap-type: inline mandatory;
    scrollbar-color: var(--section-accent) transparent;
    scrollbar-width: thin;
  }

  .product-card {
    min-width: 0;
    scroll-snap-align: start;
  }

  .product-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--ad-color-background-elevated);
    color: inherit;
    text-decoration: none;
  }

  .product-card__image,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--ad-duration-base) var(--ad-ease-standard);
  }

  .product-card__media:hover .product-card__image {
    scale: 1.025;
  }

  .product-card__index,
  .product-card__badge {
    position: absolute;
    inset-block-start: var(--ad-space-300);
    font-size: var(--ad-text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-card__index { inset-inline-start: var(--ad-space-300); }
  .product-card__badge {
    inset-inline-end: var(--ad-space-300);
    padding: var(--ad-space-50) var(--ad-space-100);
    background: var(--section-accent);
    color: var(--ad-color-text-inverse);
  }

  .product-card__details {
    display: flex;
    padding-block: var(--ad-space-300);
    border-block-end: var(--ad-border-hairline) solid color-mix(in srgb, var(--section-foreground) 24%, transparent);
    justify-content: space-between;
    gap: var(--ad-space-300);
  }

  .product-card__title,
  .product-card__price {
    font-size: var(--ad-text-body);
    font-weight: 500;
  }

  .product-card__title a {
    text-decoration: none;
  }

  .product-card__price {
    flex: 0 0 auto;
    color: color-mix(in srgb, var(--section-foreground) 72%, transparent);
  }

  .featured-collection__footer {
    display: flex;
    margin-block-start: var(--ad-space-500);
    justify-content: flex-end;
  }

  @media (max-width: 47.99rem) {
    .featured-collection__header {
      margin-block-end: var(--ad-space-500);
      align-items: flex-start;
    }

    product-rail:defined .featured-collection__controls {
      display: none;
    }

    .featured-collection__track {
      grid-auto-columns: min(82vw, 23rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection rail",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Current transmission" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Field equipment" },
    { "type": "text", "id": "link_label", "label": "Collection link label", "default": "View all objects" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 3, "max": 10, "step": 1, "default": 6 },
    { "type": "color", "id": "background", "label": "Background", "default": "#f4f3ed" },
    { "type": "color", "id": "foreground", "label": "Foreground", "default": "#080808" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#dfff00" }
  ],
  "presets": [{ "name": "Featured collection rail" }]
}
{% endschema %}
