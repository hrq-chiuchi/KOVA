{% liquid
  assign product_source = section.settings.products
  if product_source == blank and section.settings.collection != blank
    assign product_source = section.settings.collection.products
  endif
  if product_source == blank
    assign product_source = collections.all.products
  endif
%}

<section
  class="editorial-grid full-width editorial-grid--{{ section.settings.tone }}"
  data-motion-scope
  style="--editorial-accent: {{ section.settings.accent }};"
>
  <div class="editorial-grid__inner section-shell">
    <header class="editorial-grid__header" data-reveal="section">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% render 'display-heading', text: section.settings.heading, class: 'section-heading' %}
      </div>
      <div class="editorial-grid__intro">{{ section.settings.intro }}</div>
    </header>

    <div
      class="editorial-grid__products editorial-grid__products--{{ section.settings.layout }}"
      {% if section.settings.layout == 'strip' %}role="region" aria-label="{{ section.settings.heading | newline_to_br | strip_html | escape }}" tabindex="0"{% endif %}
    >
      {% if section.settings.content_mode == 'products' %}
        {% for product in product_source limit: section.settings.product_limit %}
          {% liquid
            assign card_sizes = '(max-width: 767px) 50vw, 34vw'
            case section.settings.layout
              when 'feature'
                if forloop.first
                  assign card_sizes = '(max-width: 767px) 100vw, 64vw'
                else
                  assign card_sizes = '(max-width: 767px) 50vw, 30vw'
                endif
              when 'strip'
                assign card_sizes = '(max-width: 767px) 72vw, 30vw'
            endcase
          %}
          {% render 'product-card', product: product, index: forloop.index, sizes: card_sizes, quick_add: true %}
        {% else %}
          {% for index in (1..3) %}
            <article class="editorial-placeholder" data-reveal-card>
              <div class="editorial-placeholder__media">{{ 'product-' | append: index | placeholder_svg_tag }}</div>
              <p class="eyebrow">Incoming / {{ index | prepend: '0' }}</p>
              <h3>Release pending</h3>
            </article>
          {% endfor %}
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          <article class="editorial-placeholder" data-reveal-card {{ block.shopify_attributes }}>
            <div class="editorial-placeholder__media"{% if block.settings.image != blank %} data-webgl-reveal{% endif %}>
              {% if block.settings.image != blank %}
                {{ block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '360, 540, 720, 960, 1200',
                    sizes: '(max-width: 767px) 50vw, 34vw',
                    loading: 'lazy',
                    alt: block.settings.image.alt | default: block.settings.title
                }}
              {% else %}
                {{ 'product-' | append: forloop.index | placeholder_svg_tag }}
              {% endif %}
            </div>
            <p class="eyebrow">{{ block.settings.kicker | escape }}</p>
            <h3>{{ block.settings.title | escape }}</h3>
            {% if block.settings.note != blank %}<p>{{ block.settings.note | escape }}</p>{% endif %}
          </article>
        {% else %}
          {% for index in (1..3) %}
            <article class="editorial-placeholder" data-reveal-card>
              <div class="editorial-placeholder__media">{{ 'product-' | append: index | placeholder_svg_tag }}</div>
              <p class="eyebrow">Signal {{ index | prepend: '0' }}</p>
              <h3>Field note</h3>
              <p>Campaign material incoming.</p>
            </article>
          {% endfor %}
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.link_label != blank %}
      <a class="editorial-grid__link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">
        <span>{{ section.settings.link_label | escape }}</span><span aria-hidden="true">↗</span>
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .editorial-grid { background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); }
  .editorial-grid--inverse { background: var(--ad-color-background-inverse); color: var(--ad-color-text-inverse); }
  .editorial-grid__inner { padding-block: var(--ad-section-space); }
  .editorial-grid__header { display: grid; grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); align-items: end; gap: var(--ad-content-gap); margin-block-end: var(--ad-space-700); }
  .editorial-grid__header .section-heading { margin: var(--ad-space-200) 0 0; }
  .editorial-grid__intro { max-width: 32rem; justify-self: end; color: color-mix(in srgb, currentcolor 68%, transparent); }
  .editorial-grid__intro > * { margin: 0; }
  .editorial-grid__products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.75rem, 2vw, 2rem); }
  .editorial-grid__products--staggered > :nth-child(2) { margin-block-start: var(--ad-space-700); }
  .editorial-grid__products--staggered > :nth-child(3) { margin-block-start: var(--ad-space-400); }
  /* Feature: one lead object, the rest stacked beside it. Column ratio keeps both columns close in height. */
  .editorial-grid__products--feature { grid-template-columns: minmax(0, 1.7fr) minmax(0, 0.8fr); align-items: end; }
  .editorial-grid__products--feature > :first-child { grid-row: span 3; }
  .editorial-grid__products--feature > :nth-child(n + 4) { grid-column: 2; }
  .editorial-grid__products--feature > :first-child .product-card__title { font-family: var(--font-display-family); font-size: clamp(1.5rem, 2.6vw, 2.5rem); font-weight: var(--font-display-weight); letter-spacing: -0.04em; line-height: 0.95; text-transform: uppercase; }
  /* Strip: a horizontal object index on native scroll with snap. */
  .editorial-grid__products--strip { grid-template-columns: none; grid-auto-columns: minmax(15rem, 26vw); grid-auto-flow: column; padding-block-end: var(--ad-space-300); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .editorial-grid__products--strip .product-card__media { aspect-ratio: 1; }
  .editorial-grid__link { display: flex; margin-block-start: var(--ad-space-600); padding-block: var(--ad-space-300); justify-content: space-between; border-block: var(--ad-border-hairline) solid currentcolor; font-family: var(--font-display-family); font-size: clamp(1.5rem, 3vw, 2.75rem); font-weight: var(--font-display-weight); letter-spacing: -0.04em; text-decoration: none; text-transform: uppercase; }
  .editorial-placeholder__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: color-mix(in srgb, var(--editorial-accent) 20%, var(--ad-color-background-elevated)); }
  .editorial-placeholder__media img,
  .editorial-placeholder__media svg { width: 100%; height: 100%; object-fit: cover; }
  .editorial-placeholder .eyebrow { margin: var(--ad-space-300) 0 var(--ad-space-100); }
  .editorial-placeholder h3 { margin: 0; font-family: var(--font-display-family); font-size: clamp(1.5rem, 2.4vw, 2.75rem); letter-spacing: -0.04em; line-height: 0.95; text-transform: uppercase; }
  .editorial-placeholder > p:last-child:not(.eyebrow) { color: color-mix(in srgb, currentcolor 64%, transparent); }

  @media (max-width: 47.99rem) {
    .editorial-grid__header { grid-template-columns: 1fr; margin-block-end: var(--ad-space-500); }
    .editorial-grid__intro { justify-self: start; }
    .editorial-grid__products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .editorial-grid__products:not(.editorial-grid__products--strip) > :nth-child(3) { grid-column: 2; }
    .editorial-grid__products--feature { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .editorial-grid__products--feature > :first-child { grid-column: 1 / -1; grid-row: auto; }
    .editorial-grid__products--feature > :nth-child(n + 4) { grid-column: auto; }
    .editorial-grid__products--strip { grid-template-columns: none; grid-auto-columns: 72vw; }
    .editorial-grid__products--staggered > :nth-child(2) { margin-block-start: var(--ad-space-500); }
    .editorial-grid__products--staggered > :nth-child(3) { margin-block-start: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial product grid",
  "tag": "section",
  "class": "section-editorial-product-grid",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Current transmission" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "FIELD\nEQUIPMENT" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Objects and apparel selected for movement after dark.</p>" },
    { "type": "select", "id": "content_mode", "label": "Content", "default": "products", "options": [{ "value": "products", "label": "Products" }, { "value": "editorial", "label": "Editorial placeholders" }] },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 6 },
    { "type": "range", "id": "product_limit", "label": "Product limit", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "staggered", "options": [{ "value": "aligned", "label": "Aligned" }, { "value": "staggered", "label": "Staggered" }, { "value": "feature", "label": "Feature (one large, others stacked)" }, { "value": "strip", "label": "Horizontal strip" }] },
    { "type": "select", "id": "tone", "label": "Tone", "default": "dark", "options": [{ "value": "dark", "label": "Dark" }, { "value": "inverse", "label": "Light" }] },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#dfff00" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View the full index" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Editorial card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Signal / 01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Field note" },
        { "type": "text", "id": "note", "label": "Note", "default": "Campaign material incoming." }
      ]
    }
  ],
  "presets": [{ "name": "Editorial product grid", "blocks": [{ "type": "story" }, { "type": "story" }, { "type": "story" }] }]
}
{% endschema %}
