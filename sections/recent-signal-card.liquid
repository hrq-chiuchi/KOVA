{% comment %}
  Renders one product card for Recent signals, requested as /products/<handle>?section_id=recent-signal-card.
  It has no preset: it is never placed on a page, only rendered through the Section Rendering API.
{% endcomment %}
{% comment %} A removed handle still answers 200 with an empty product, so say so explicitly. {% endcomment %}
{% if product.id %}
  {% comment %} Compact row, not the editorial card: Recent signals is a history strip, kept visibly lighter than Related equipment above it. {% endcomment %}
  <a class="recent-signal" href="{{ product.url }}" data-recent-card>
    <span class="recent-signal__media">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '4rem', loading: 'lazy', alt: '' }}
      {% else %}
        {% render 'media-pending', title: product.title, compact: true %}
      {% endif %}
    </span>
    <span class="recent-signal__copy">
      <span class="recent-signal__title">{{ product.title | escape }}</span>
      <span class="recent-signal__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>
      {%- capture status -%}{% render 'product-status', product: product, format: 'text' %}{%- endcapture -%}
      {% if status != blank %}<span class="recent-signal__status">{{ status }}</span>{% endif %}
    </span>
  </a>
{% else %}
  <div data-recent-missing></div>
{% endif %}

{% stylesheet %}
  .recent-signal { display: grid; grid-template-columns: 4rem minmax(0, 1fr); align-items: center; gap: var(--ad-space-300); text-decoration: none; }
  .recent-signal__media { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--ad-color-background-elevated); }
  .recent-signal__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* The thumbnail is too small for the pending label; the frame corners alone mark missing photography. */
  .recent-signal__media .media-pending { padding: var(--ad-space-200); }
  .recent-signal__media .media-pending__label { display: none; }
  .recent-signal__copy { display: grid; min-width: 0; gap: var(--ad-space-50); font-size: var(--ad-text-label); letter-spacing: 0.08em; text-transform: uppercase; }
  .recent-signal__title { font-weight: 700; }
  .recent-signal__copy > :not(.recent-signal__title) { color: var(--ad-color-text-muted); }
  .recent-signal:hover .recent-signal__title,
  .recent-signal:focus-visible .recent-signal__title { text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "Recent signal card",
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
