{%- comment -%}
  Announcement bar (D-045). Shows the first enabled message only: no rotation and no ticker. Merchants
  reorder blocks to change what is shown. A Shipping message takes its amount from the Field Supply
  threshold, so it cannot drift from the bag, and is skipped where the free rate does not apply.
  Renders no markup when nothing qualifies.
{%- endcomment -%}
{%- capture free_shipping_eligible -%}{%- render 'free-shipping-eligible' -%}{%- endcapture -%}
{%- assign message = nil -%}
{%- for block in section.blocks -%}
  {%- unless block.settings.enabled -%}{%- continue -%}{%- endunless -%}
  {%- if block.settings.kind == 'shipping' -%}
    {%- if free_shipping_eligible == 'true' -%}
      {%- assign message = block -%}
      {%- break -%}
    {%- endif -%}
  {%- elsif block.settings.text != blank -%}
    {%- assign message = block -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if message -%}
  <aside class="announcement-bar full-width" aria-label="Store announcement" data-announcement data-kind="{{ message.settings.kind }}" {{ message.shopify_attributes }}>
    <div class="announcement-bar__inner">
      {%- liquid
        case message.settings.kind
          when 'drop'
            assign kind_label = 'Drop'
          when 'shipping'
            assign kind_label = 'Field supply'
          when 'editorial'
            assign kind_label = 'Editorial'
          when 'product'
            assign kind_label = 'Product'
          else
            assign kind_label = 'System'
        endcase
      -%}
      <span class="announcement-bar__label">{{ message.settings.label | default: kind_label | escape }}</span>
      <p class="announcement-bar__text">
        {%- if message.settings.kind == 'shipping' -%}
          Complimentary standard shipping on orders over {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}
        {%- else -%}
          {{ message.settings.text | escape }}
        {%- endif -%}
      </p>
      {%- if message.settings.link != blank -%}
        <a class="announcement-bar__link" href="{{ message.settings.link }}">
          {{- message.settings.link_label | default: 'View' | escape -}}
          <span aria-hidden="true"> ↗</span>
        </a>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% stylesheet %}
  .announcement-bar { border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; line-height: 1.3; text-transform: uppercase; }
  .announcement-bar__inner { display: flex; width: min(100% - (2 * var(--ad-page-padding)), var(--ad-container-width)); min-height: 2.25rem; margin-inline: auto; padding-block: var(--ad-space-100); flex-wrap: wrap; align-items: center; justify-content: center; column-gap: var(--ad-space-300); row-gap: var(--ad-space-50); text-align: center; }
  .announcement-bar__label { color: var(--color-accent); }
  .announcement-bar__text { margin: 0; }
  .announcement-bar__link { display: inline-flex; min-height: 1.5rem; align-items: center; color: inherit; text-decoration: underline; text-underline-offset: 0.25em; }
  .announcement-bar__link:hover { color: var(--color-accent); }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "section-announcement-bar",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Only the first enabled message is shown. Reorder messages to change it. A Shipping message uses the Field Supply threshold from Theme settings > Commerce and is hidden where that rate does not apply." }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Enabled", "default": true },
        {
          "type": "select",
          "id": "kind",
          "label": "Type",
          "options": [
            { "value": "drop", "label": "Drop" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "editorial", "label": "Editorial" },
            { "value": "product", "label": "Product" },
            { "value": "system", "label": "System" }
          ],
          "default": "drop"
        },
        { "type": "text", "id": "label", "label": "Label", "info": "Short tag before the message, for example Drop 001 / Active. Defaults to the type." },
        { "type": "text", "id": "text", "label": "Message", "info": "Ignored for Shipping, which writes its own sentence from the threshold." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "kind": "drop", "label": "Drop 001 / Active", "text": "The first release is live.", "link": "shopify://collections/drop-001", "link_label": "Enter drop" } },
        { "type": "message", "settings": { "kind": "shipping" } }
      ]
    }
  ]
}
{% endschema %}
