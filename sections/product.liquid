{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign kova = product.metafields.custom
  assign material = kova.material_system.value
  assign fit = kova.fit_profile.value
  assign edition = kova.edition_profile.value
  assign guide = kova.reference_guide.value
%}

<section class="product-page full-width">
  <div class="product-page__inner section-shell">
    <aside class="product-page__identity">
      <p class="eyebrow">KOVA / {{ product.type | default: 'Field object' | escape }}</p>
      <h1>{{ product.title | escape }}</h1>
      {% if kova.functional_descriptor.value != blank %}
        <p class="product-page__descriptor">{{ kova.functional_descriptor.value | escape }}</p>
      {% endif %}
      {% if product.vendor != blank %}<p class="product-page__vendor">{{ product.vendor | escape }}</p>{% endif %}
      <p class="product-page__index">
        {% if edition.drop_code.value != blank %}{{ edition.drop_code.value | escape }}{% else %}Object {{ product.id | modulo: 100 | prepend: '0' | slice: -2, 2 }}{% endif %}
        {% if edition.edition_quantity.value != blank %}<span>/ {{ edition.edition_quantity.value }} units</span>{% endif %}
      </p>
      {% if section.settings.show_manual_link %}
        <a class="product-page__manual-link" href="#field-manual">
          <span>Read the field manual</span><span aria-hidden="true">↓</span>
        </a>
      {% endif %}
    </aside>

    <div class="product-page__gallery" aria-label="{{ product.title | escape }} media">
      {% for media in product.media %}
        {% liquid
          # The primary image is the likely LCP element, so it loads eagerly at high priority.
          if forloop.first
            assign media_loading = 'eager'
            assign media_priority = 'high'
          else
            assign media_loading = 'lazy'
            assign media_priority = 'auto'
          endif
        %}
        <figure class="product-page__media{% if forloop.first %} product-page__media--primary{% endif %}" data-media-id="{{ media.id }}">
          {% case media.media_type %}
            {% when 'image' %}
              {{ media
                | image_url: width: 1800
                | image_tag:
                  widths: '480, 720, 960, 1200, 1600, 1800',
                  sizes: '(max-width: 767px) 100vw, 52vw',
                  loading: media_loading,
                  fetchpriority: media_priority,
                  alt: media.alt | default: product.title
              }}
            {% when 'video' %}
              {{ media | media_tag: image_size: '1200x', controls: true }}
            {% when 'external_video' %}
              {{ media | external_video_tag }}
            {% when 'model' %}
              {{ media | model_viewer_tag }}
          {% endcase %}
        </figure>
      {% else %}
        <figure class="product-page__media product-page__media--primary">{% render 'media-pending', title: product.title %}</figure>
      {% endfor %}
    </div>

    <product-purchase class="product-purchase">
      <div class="product-purchase__topline">
        <p class="product-purchase__price" data-product-price>{{ current_variant.price | money }}</p>
        {% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}
      </div>

      {% form 'product', product, class: 'product-purchase__form', data-product-purchase-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {% unless product.has_only_default_variant %}
          <div class="product-purchase__options">
            {% for option in product.options_with_values %}
              <fieldset>
                <legend class="form-legend">{{ option.name | escape }}</legend>
                <div class="product-purchase__values">
                  {% for value in option.values %}
                    <input
                      class="visually-hidden"
                      type="radio"
                      id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      data-option-value
                      data-option-position="{{ option.position }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">
                      {%- if value.swatch.color != blank -%}
                        <span class="product-purchase__swatch" style="background: {{ value.swatch.color }};" aria-hidden="true"></span>
                      {%- endif -%}
                      {{- value | escape -}}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="product-purchase__quantity">
          <span class="form-legend">Quantity</span>
          <div>
            <button type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
            <label>
              <span class="visually-hidden">Quantity</span>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-quantity-input>
            </label>
            <button type="button" data-quantity-plus aria-label="Increase quantity">+</button>
          </div>
        </div>

        <button class="button button--accent product-purchase__add" type="submit" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
          {% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}
        </button>
        <p class="status-message" role="status" aria-live="polite" data-product-status></p>
        <div class="product-purchase__payment">{{ form | payment_button }}</div>
      {% endform %}

      <div class="product-purchase__details">
        {% if kova.technical_specifications.value != blank %}
          <details>
            <summary>Specifications</summary>
            {% render 'record-list',
              text: kova.technical_specifications.value,
              class: 'product-purchase__richtext product-purchase__specs',
              keep_unlabelled: true
            %}
          </details>
        {% endif %}
        {% if fit != blank %}
          <details>
            <summary>Fit / {{ fit.name.value | escape }}</summary>
            <div class="product-purchase__richtext">
              {% if fit.silhouette.value != blank %}<p>{{ fit.silhouette.value | escape }}</p>{% endif %}
              {% if fit.layering_guidance.value != blank %}<p>{{ fit.layering_guidance.value | escape }}</p>{% endif %}
              {% if fit.sizing_note.value != blank %}<p>{{ fit.sizing_note.value | escape }}</p>{% endif %}
            </div>
          </details>
        {% endif %}
        {% if material != blank %}
          <details>
            <summary>Material / {{ material.name.value | escape }}</summary>
            <dl class="product-purchase__richtext product-purchase__specs">
              {% if material.composition.value != blank %}<div><dt>Composition</dt><dd>{{ material.composition.value | escape }}</dd></div>{% endif %}
              {% if material.construction.value != blank %}<div><dt>Construction</dt><dd>{{ material.construction.value | escape }}</dd></div>{% endif %}
              {% if material.finish.value != blank %}<div><dt>Finish</dt><dd>{{ material.finish.value | escape }}</dd></div>{% endif %}
              {% if material.hardware.value != blank %}<div><dt>Hardware</dt><dd>{{ material.hardware.value | escape }}</dd></div>{% endif %}
              {% if material.care.value != blank %}<div><dt>Care</dt><dd>{{ material.care.value | escape }}</dd></div>{% endif %}
            </dl>
          </details>
        {% elsif section.settings.care_copy != blank %}
          <details>
            <summary>Care and material</summary>
            <div class="product-purchase__richtext">{{ section.settings.care_copy }}</div>
          </details>
        {% endif %}
        <details>
          <summary>Delivery and returns</summary>
          <div class="product-purchase__richtext">
            {{ section.settings.delivery_copy }}
            {% if kova.package_information.value != blank %}
              <p>{{ kova.package_information.value | escape | newline_to_br }}</p>
            {% endif %}
          </div>
        </details>
        {% if guide.url != blank %}
          <a class="product-purchase__guide" href="{{ guide.url }}" target="_blank" rel="noopener">
            <span>{{ guide.alt | default: 'Reference guide' | escape }}</span>
            <span>PDF <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></span>
          </a>
        {% endif %}
      </div>

      <script type="application/json" data-variant-json>
        [
          {% for variant in product.variants %}
            {
              "id": {{ variant.id }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | money | json }},
              "options": {{ variant.options | json }},
              "featured_media_id": {{ variant.featured_media.id | default: 'null' }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      </script>
    </product-purchase>
  </div>
</section>

{% stylesheet %}
  .product-page { background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); }
  .product-page__inner { display: grid; grid-template-columns: minmax(18rem, 0.8fr) minmax(28rem, 1.4fr) minmax(18rem, 0.75fr); gap: var(--ad-content-gap); padding-block: var(--ad-space-500) var(--ad-section-space); }
  .product-page__identity,
  .product-purchase { position: sticky; top: calc(var(--ad-header-height) + var(--ad-space-400)); align-self: start; }
  .product-page__identity h1 { margin-block: var(--ad-space-300); font-family: var(--font-display-family); font-size: clamp(2.5rem, 3.5vw, 4.5rem); font-weight: var(--font-display-weight); letter-spacing: -0.065em; line-height: 0.86; text-transform: uppercase; }
  .product-page__vendor,
  .product-page__index { color: var(--ad-color-text-muted); font-size: var(--ad-text-label); letter-spacing: 0.1em; text-transform: uppercase; }
  .product-page__index { margin-block-start: var(--ad-space-600); }
  .product-page__index span { margin-inline-start: var(--ad-space-100); }
  .product-page__manual-link { display: inline-flex; margin-block-start: var(--ad-space-500); padding-block: var(--ad-space-200); gap: var(--ad-space-200); border-block-end: var(--ad-border-hairline) solid currentcolor; font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; }
  .product-page__descriptor { margin: 0 0 var(--ad-space-300); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .product-page__gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ad-space-200); }
  .product-page__media { aspect-ratio: 4 / 5; overflow: hidden; background: var(--ad-color-background-elevated); }
  .product-page__media--primary { grid-column: 1 / -1; aspect-ratio: 5 / 6; }
  .product-page__media img,
  .product-page__media video,
  .product-page__media iframe,
  .product-page__media model-viewer,
  .product-page__media svg { width: 100%; height: 100%; object-fit: cover; }
  .product-purchase { display: block; }
  .product-purchase__topline { display: flex; padding-block-end: var(--ad-space-300); align-items: baseline; justify-content: space-between; border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); }
  .product-purchase__price { font-family: var(--font-display-family); font-size: clamp(1.75rem, 3vw, 2.6rem); }
  .product-purchase__form { display: grid; gap: var(--ad-space-400); padding-block: var(--ad-space-400); }
  .product-purchase__options { display: grid; gap: var(--ad-space-400); }
  .product-purchase__options fieldset { padding: 0; border: 0; }
  .product-purchase__values { display: flex; margin-block-start: var(--ad-space-200); flex-wrap: wrap; gap: var(--ad-space-100); }
  .product-purchase__values label { display: inline-flex; min-width: var(--ad-control-minimum); min-height: var(--ad-control-minimum); padding-inline: var(--ad-space-200); align-items: center; justify-content: center; border: var(--ad-border-hairline) solid var(--ad-color-border-subtle); cursor: pointer; font-size: var(--ad-text-label); text-transform: uppercase; }
  .product-purchase__values input:checked + label { border-color: var(--color-accent); background: var(--color-accent); color: var(--ad-color-text-inverse); }
  .product-purchase__values input:focus-visible + label { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .product-purchase__quantity { display: flex; align-items: center; justify-content: space-between; }
  .product-purchase__quantity > div { display: grid; grid-template-columns: var(--ad-control-minimum) 3.5rem var(--ad-control-minimum); }
  .product-purchase__quantity button,
  .product-purchase__quantity input { width: 100%; min-height: var(--ad-control-minimum); border: var(--ad-border-hairline) solid var(--ad-color-border-subtle); background: transparent; text-align: center; }
  .product-purchase__quantity input { border-inline: 0; }
  .product-purchase__add { width: 100%; }
  .product-purchase__payment .shopify-payment-button { margin: 0; }
  .product-purchase__payment .shopify-payment-button__button--unbranded { min-height: var(--ad-control-minimum); border: var(--ad-border-hairline) solid currentcolor; border-radius: var(--ad-radius-pill); background: transparent; color: var(--ad-color-text-primary); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .product-purchase__payment .shopify-payment-button__button--unbranded:hover:not([disabled]) { background: var(--ad-color-text-primary); color: var(--ad-color-text-inverse); }
  .product-purchase__details { border-block-start: var(--ad-border-hairline) solid var(--ad-color-border-subtle); }
  .product-purchase__details details { border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); }
  .product-purchase__details summary { padding-block: var(--ad-space-300); cursor: pointer; font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .product-purchase__richtext { padding-block-end: var(--ad-space-400); color: var(--ad-color-text-muted); }
  .product-purchase__richtext > * + * { margin-block-start: var(--ad-space-300); }
  .product-purchase__swatch { display: inline-block; width: 0.9em; height: 0.9em; margin-inline-end: var(--ad-space-100); border: var(--ad-border-hairline) solid var(--ad-color-border-subtle); vertical-align: -0.1em; }
  .product-purchase__specs { margin: 0; }
  .product-purchase__specs > div { display: grid; grid-template-columns: minmax(6rem, 0.4fr) 1fr; gap: var(--ad-space-200); }
  .product-purchase__specs dt { color: var(--ad-color-text-primary); font-size: var(--ad-text-label); letter-spacing: 0.1em; text-transform: uppercase; }
  .product-purchase__specs dd { margin: 0; grid-column: 2; }
  .product-purchase__guide { display: flex; min-height: var(--ad-control-minimum); padding-block: var(--ad-space-300); align-items: center; justify-content: space-between; border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; }

  @media (max-width: 74.99rem) {
    .product-page__inner { grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.8fr); }
    .product-page__identity { position: static; grid-column: 1 / -1; }
    .product-page__index { margin-block-start: var(--ad-space-300); }
  }

  @media (max-width: 47.99rem) {
    .product-page__inner { display: flex; padding-block-start: var(--ad-space-300); flex-direction: column; }
    .product-page__identity { order: 1; }
    .product-page__gallery { order: 2; margin-inline: calc(var(--ad-page-padding) * -1); gap: 2px; }
    .product-purchase { position: static; order: 3; }
    .product-page__media--primary { aspect-ratio: 4 / 5; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_manual_link", "label": "Link to the product field manual section", "info": "Turn off if the template has no Product field manual section.", "default": true },
    { "type": "richtext", "id": "delivery_copy", "label": "Delivery and returns", "default": "<p>Dispatch timing and return eligibility are confirmed at checkout.</p>" },
    { "type": "richtext", "id": "care_copy", "label": "Care and material", "default": "<p>Follow the care instructions supplied with the object.</p>" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
