{% comment %}
  Rendered only through the Section Rendering API by the search command (assets/search-command.js),
  from routes.predictive_search_url with section_id=predictive-search (D-037). Results are grouped
  as listbox groups; every result is a `role="option"` link so a click navigates natively and the
  combobox moves `aria-activedescendant` across them for keyboard use.
{% endcomment %}
{%- liquid
  assign terms = predictive_search.terms
  assign resources = predictive_search.resources
  assign total = resources.products.size | plus: resources.articles.size | plus: resources.collections.size | plus: resources.pages.size
  assign encoded_terms = terms | url_encode
  assign search_all_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'
-%}
<div class="predictive-search" data-predictive-results data-count="{{ total }}">
  {% if predictive_search.performed %}
    {% if resources.products.size > 0 %}
      <div class="predictive-search__group" role="group" aria-labelledby="PredictiveEquipment">
        <p class="predictive-search__heading" id="PredictiveEquipment" aria-hidden="true">
          {{ 'search.command.equipment' | t }} <span>{{ resources.products.size | prepend: '0' | slice: -2, 2 }}</span>
        </p>
        {% for product in resources.products %}
          <a class="predictive-search__option" id="PredictiveProduct-{{ product.id }}" href="{{ product.url }}" role="option" aria-selected="false" tabindex="-1">
            <span class="predictive-search__thumb">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 60, height: 75 }}
              {% endif %}
            </span>
            <span class="predictive-search__title">{{ product.title | escape }}</span>
            <span class="predictive-search__meta">
              {% if product.metafields.custom.index_type.value != blank %}<span>{{ product.metafields.custom.index_type.value | escape }}</span>{% endif %}
              {%- capture status_text %}{% render 'product-status', product: product, format: 'text' %}{% endcapture -%}
              {% if status_text != blank %}<span>{{ status_text }}</span>{% endif %}
              <span>{% if product.price_varies %}{{ 'search.command.from' | t }} {% endif %}{{ product.price | money }}</span>
            </span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if resources.articles.size > 0 %}
      <div class="predictive-search__group" role="group" aria-labelledby="PredictiveNotes">
        <p class="predictive-search__heading" id="PredictiveNotes" aria-hidden="true">
          {{ 'search.command.field_notes' | t }} <span>{{ resources.articles.size | prepend: '0' | slice: -2, 2 }}</span>
        </p>
        {% for article in resources.articles %}
          {% comment %} Only products always have photography; other results drop the thumbnail column rather than leave it empty. {% endcomment %}
          <a class="predictive-search__option{% unless article.image %} predictive-search__option--text{% endunless %}" id="PredictiveArticle-{{ article.id }}" href="{{ article.url }}" role="option" aria-selected="false" tabindex="-1">
            {% if article.image %}
              <span class="predictive-search__thumb">
                {{ article.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 60, height: 75 }}
              </span>
            {% endif %}
            <span class="predictive-search__title">{{ article.title | escape }}</span>
            <span class="predictive-search__meta"><span>{{ article.published_at | date: '%Y.%m.%d' }}</span></span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if resources.collections.size > 0 %}
      <div class="predictive-search__group" role="group" aria-labelledby="PredictiveCollections">
        <p class="predictive-search__heading" id="PredictiveCollections" aria-hidden="true">
          {{ 'search.command.collections' | t }} <span>{{ resources.collections.size | prepend: '0' | slice: -2, 2 }}</span>
        </p>
        {% for collection in resources.collections %}
          <a class="predictive-search__option predictive-search__option--text" id="PredictiveCollection-{{ collection.id }}" href="{{ collection.url }}" role="option" aria-selected="false" tabindex="-1">
            <span class="predictive-search__title">{{ collection.title | escape }}</span>
            <span class="predictive-search__meta"><span>{{ collection.all_products_count }} {{ 'search.command.objects' | t }}</span></span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if resources.pages.size > 0 %}
      <div class="predictive-search__group" role="group" aria-labelledby="PredictivePages">
        <p class="predictive-search__heading" id="PredictivePages" aria-hidden="true">
          {{ 'search.command.pages' | t }} <span>{{ resources.pages.size | prepend: '0' | slice: -2, 2 }}</span>
        </p>
        {% for page in resources.pages %}
          <a class="predictive-search__option predictive-search__option--text" id="PredictivePage-{{ page.id }}" href="{{ page.url }}" role="option" aria-selected="false" tabindex="-1">
            <span class="predictive-search__title">{{ page.title | escape }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if total == 0 %}
      <p class="predictive-search__empty">{{ 'search.command.no_matches' | t: terms: terms }}</p>
    {% endif %}

    <div class="predictive-search__group" role="group" aria-label="{{ 'search.command.all_results_group' | t }}">
      <a class="predictive-search__option predictive-search__option--all" id="PredictiveAll" href="{{ search_all_url }}" role="option" aria-selected="false" tabindex="-1">
        <span class="predictive-search__title">{{ 'search.command.all_results' | t: terms: terms }}</span>
        <span class="predictive-search__meta" aria-hidden="true"><span>↵</span></span>
      </a>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .predictive-search__group { display: grid; }
  /* Margins, not a grid gap: the search command copies these groups into its own, non-grid container. */
  .predictive-search__group + .predictive-search__group,
  .predictive-search__group + .predictive-search__empty,
  .predictive-search__empty + .predictive-search__group { margin-block-start: var(--ad-space-600); }
  .predictive-search__heading { display: flex; margin: 0 0 var(--ad-space-100); justify-content: space-between; color: var(--ad-color-text-muted); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .predictive-search__heading span { font-variant-numeric: tabular-nums; }
  .predictive-search__option { display: grid; min-height: 3.5rem; padding: var(--ad-space-100); grid-template-columns: 2.5rem minmax(0, 1fr) auto; align-items: center; gap: var(--ad-space-300); border-block-end: var(--ad-border-hairline) solid var(--ad-color-border-subtle); text-decoration: none; }
  .predictive-search__option:hover,
  .predictive-search__option[aria-selected='true'] { background: var(--ad-color-background-primary); box-shadow: inset 2px 0 0 var(--color-accent); }
  .predictive-search__option[aria-selected='true'] .predictive-search__title { color: var(--color-accent); }
  .predictive-search__option--text { grid-template-columns: minmax(0, 1fr) auto; }
  .predictive-search__option--all { grid-template-columns: minmax(0, 1fr) auto; border-block-end: 0; }
  .predictive-search__thumb { display: block; overflow: hidden; inline-size: 2.5rem; aspect-ratio: 4 / 5; background: var(--ad-color-background-primary); }
  .predictive-search__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .predictive-search__title { overflow: hidden; font-weight: 600; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
  .predictive-search__meta { display: flex; gap: var(--ad-space-200); color: var(--ad-color-text-muted); font-size: var(--ad-text-label); font-variant-numeric: tabular-nums; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .predictive-search__empty { margin: 0; color: var(--ad-color-text-muted); }

  @media (max-width: 29.99rem) {
    .predictive-search__option { grid-template-columns: 2.5rem minmax(0, 1fr); align-content: center; gap: var(--ad-space-50) var(--ad-space-300); }
    .predictive-search__option .predictive-search__thumb { grid-row: span 2; }
    .predictive-search__option .predictive-search__meta { grid-column: 2; }
    .predictive-search__option--text { grid-template-columns: minmax(0, 1fr); }
    .predictive-search__option--text .predictive-search__meta { grid-column: 1; }
    .predictive-search__option--all { grid-template-columns: minmax(0, 1fr) auto; }
    .predictive-search__option--all .predictive-search__meta { grid-column: auto; }
    .predictive-search__title { white-space: normal; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
