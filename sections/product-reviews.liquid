{% comment %}
  Reviews come only from real data: Shopify's standard `reviews` metafields, which review apps populate,
  and review-app blocks. The theme never ships authored or sample reviews.
{% endcomment %}
{% liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign has_app_block = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
%}

<section
  class="product-reviews full-width product-reviews--{{ section.settings.tone }}"
  data-motion-scope
  aria-labelledby="ReviewsHeading-{{ section.id }}"
>
  <div class="product-reviews__inner section-shell">
    <header class="product-reviews__header" data-reveal="section">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% assign heading_id = 'ReviewsHeading-' | append: section.id %}
        {% render 'display-heading', text: section.settings.heading, id: heading_id, class: 'section-heading' %}
      </div>

      {% if rating != blank and rating_count > 0 %}
        {% liquid
          assign scale = rating.scale_max | default: 5
          assign percent = rating.rating | times: 100.0 | divided_by: scale
        %}
        <div class="product-reviews__summary">
          <p class="product-reviews__score">
            {{ rating.rating | round: 1 }}<span>/ {{ scale }}</span>
          </p>
          <div class="product-reviews__meter" role="img" aria-label="Rated {{ rating.rating | round: 1 }} out of {{ scale }}">
            <span style="width: {{ percent | round: 1 }}%;"></span>
          </div>
          <p class="product-reviews__count">{{ rating_count }} {{ rating_count | pluralize: 'field report', 'field reports' }}</p>
        </div>
      {% endif %}
    </header>

    {% if has_app_block %}
      <div class="product-reviews__app">
        {% for block in section.blocks %}
          {% if block.type == '@app' %}{% render block %}{% endif %}
        {% endfor %}
      </div>
    {% elsif rating_count == 0 %}
      <div class="product-reviews__empty">
        <p class="product-reviews__empty-title">{{ section.settings.empty_title | escape }}</p>
        {% if section.settings.empty_text != blank %}
          <div class="product-reviews__empty-text">{{ section.settings.empty_text }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .product-reviews { background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); }
  .product-reviews--inverse { background: var(--ad-color-background-inverse); color: var(--ad-color-text-inverse); }
  .product-reviews__inner { padding-block: var(--ad-section-space); }
  .product-reviews__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--ad-content-gap); margin-block-end: var(--ad-space-600); }
  .product-reviews__header .section-heading { margin: var(--ad-space-200) 0 0; }
  .product-reviews__summary { display: grid; justify-items: end; gap: var(--ad-space-200); }
  .product-reviews__score { margin: 0; font-family: var(--font-display-family); font-size: clamp(3rem, 7vw, 6rem); font-weight: var(--font-display-weight); letter-spacing: -0.06em; line-height: 0.85; }
  .product-reviews__score span { margin-inline-start: var(--ad-space-100); font-size: 0.3em; letter-spacing: 0; opacity: 0.6; }
  .product-reviews__meter { position: relative; width: 12rem; height: 0.4rem; overflow: hidden; background: color-mix(in srgb, currentcolor 20%, transparent); }
  .product-reviews__meter span { position: absolute; inset: 0 auto 0 0; background: var(--color-accent); }
  .product-reviews__count { margin: 0; font-size: var(--ad-text-label); letter-spacing: 0.12em; text-transform: uppercase; }
  .product-reviews__empty { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--ad-content-gap); padding-block: var(--ad-space-500); border-block: var(--ad-border-hairline) solid color-mix(in srgb, currentcolor 28%, transparent); }
  .product-reviews__empty-title { margin: 0; font-family: var(--font-display-family); font-size: clamp(1.5rem, 3vw, 2.75rem); font-weight: var(--font-display-weight); letter-spacing: -0.04em; line-height: 1; text-transform: uppercase; }
  .product-reviews__empty-text { max-width: 32rem; color: color-mix(in srgb, currentcolor 68%, transparent); }
  .product-reviews__empty-text > * { margin: 0; }

  @media (max-width: 47.99rem) {
    .product-reviews__header,
    .product-reviews__empty { grid-template-columns: 1fr; }
    .product-reviews__summary { justify-items: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews",
  "tag": "div",
  "class": "section-product-reviews",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Field reports" },
    { "type": "text", "id": "empty_title", "label": "Empty state title", "default": "No field reports yet" },
    { "type": "richtext", "id": "empty_text", "label": "Empty state text", "default": "<p>Customer reviews will appear here once this object has been in the field.</p>" },
    { "type": "select", "id": "tone", "label": "Tone", "default": "dark", "options": [{ "value": "dark", "label": "Dark" }, { "value": "inverse", "label": "Light" }] }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
