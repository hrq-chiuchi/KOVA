{% doc %}
  Renders multi-line "Label: value" text as a definition list. The text before the first colon
  is the label. Blank lines are skipped.

  @param {string} text - Multi-line source, such as custom.technical_specifications
  @param {string} [class] - Class for the dl element
  @param {number} [limit] - Maximum source lines read (default 50); counts lines before skipping
  @param {boolean} [keep_unlabelled] - Render lines without a colon as a value-only row (default false)

  @example
  {% render 'record-list', text: kova.technical_specifications.value, class: 'signal-frame__specs', limit: 5 %}
{% enddoc %}
{%- liquid
  assign line_limit = limit | default: 50
  assign lines = text | newline_to_br | split: '<br />'
-%}
<dl{% if class != blank %} class="{{ class }}"{% endif %}>
  {% for raw_line in lines limit: line_limit %}
    {% assign line = raw_line | strip %}
    {% if line == blank %}{% continue %}{% endif %}
    {% if line contains ':' %}
      {% assign record_label = line | split: ':' | first %}
      <div>
        <dt>{{ record_label | strip | escape }}</dt>
        <dd>{{ line | remove_first: record_label | remove_first: ':' | strip | escape }}</dd>
      </div>
    {% elsif keep_unlabelled %}
      <div><dd>{{ line | escape }}</dd></div>
    {% endif %}
  {% endfor %}
</dl>
