{% doc %}
  Cross-document page transition: opt-in, render blocking, link prefetch, and the signal layer.
  The SVG filters that drive the corrupted-signal effect live in `signal-filters`. Navigation stays
  native; unsupported browsers, reduced motion, and the Theme Editor get ordinary page loads.

  @param {string} part - `head` for the opt-in and hints, `body` for the signal layer.
{% enddoc %}

{% if settings.page_transitions and request.design_mode == false %}
  {% if part == 'head' %}
    <style>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition { navigation: auto; }
      }
    </style>
    {% comment %} Hold the first frame until the main landmark is parsed, so the new page never reveals half-drawn. {% endcomment %}
    <link rel="expect" href="#MainContent" blocking="render">
    {{ 'page-transition.css' | asset_url | stylesheet_tag }}
    {% comment %} Inline on purpose: the `pagereveal` listener must exist before the first render. {% endcomment %}
    <script>{{ 'page-transition.js' | inline_asset_content }}</script>
    <script type="speculationrules">
      {
        "prefetch": [{
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": ["/cart", "/cart/*", "/checkout*", "/checkouts/*", "/account*", "/customer_authentication/*"] } },
              { "not": { "selector_matches": "[target], [download], [rel~='nofollow'], [data-no-prefetch]" } }
            ]
          },
          "eagerness": "moderate"
        }]
      }
    </script>
  {% else %}
    {% comment %} Invisible in normal rendering; its transition group carries the scanline sweep. {% endcomment %}
    <div class="page-signal" aria-hidden="true"></div>
  {% endif %}
{% endif %}
