{% doc %}
  Renders the canonical editorial product card.

  @param {product} product - Product to render.
  @param {number} [index] - One-based product index.
  @param {string} [sizes] - Responsive image sizes attribute.
  @param {boolean} [quick_add] - Show the quick-add action (snippets/quick-add): Add for single-variant products, Options otherwise.
  @param {string} [heading_tag] - Title heading element, `h2` or `h3` (default) to fit the page outline.
{% enddoc %}

{% liquid
  assign alternate_image = blank
  assign heading_tag = heading_tag | default: 'h3'
  if product.featured_image
    for image in product.images
      if image.id != product.featured_image.id
        assign alternate_image = image
        break
      endif
    endfor
  endif
%}

<article class="product-card" data-reveal-card>
  <a class="product-card__media{% if alternate_image != blank %} product-card__media--alternate{% endif %}" href="{{ product.url }}" tabindex="-1" aria-hidden="true"{% if product.featured_image %} data-webgl-reveal{% endif %}>
    {% if product.featured_image %}
      {{ product.featured_image
        | image_url: width: 1200
        | image_tag:
          widths: '360, 540, 720, 960, 1200',
          sizes: sizes,
          loading: 'lazy',
          class: 'product-card__image',
          alt: product.featured_image.alt | default: product.title
      }}
      {% if alternate_image != blank %}
        {{ alternate_image
          | image_url: width: 1200
          | image_tag:
            widths: '360, 540, 720, 960, 1200',
            sizes: sizes,
            loading: 'lazy',
            class: 'product-card__image product-card__image--alternate',
            alt: ''
        }}
      {% endif %}
    {% else %}
      {% render 'media-pending', title: product.title, compact: true %}
    {% endif %}
    {% if index %}<span class="product-card__index" aria-hidden="true">{{ index | prepend: '0' | slice: -2, 2 }}</span>{% endif %}
    {% render 'product-status', product: product, format: 'card' %}
  </a>
  <div class="product-card__details">
    <div>
      <{{ heading_tag }} class="product-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></{{ heading_tag }}>
      <p class="product-card__price">
        {% render 'product-status', product: product, format: 'sr' %}
        {% if product.price_varies %}From {% endif %}{{ product.price | money }}
        {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
      </p>
    </div>
    {% if quick_add %}{% render 'quick-add', product: product %}{% endif %}
  </div>
</article>

{% stylesheet %}
  .product-card { min-width: 0; color: inherit; scroll-snap-align: start; }
  .product-card__media { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 5; background: var(--ad-color-background-elevated); color: inherit; text-decoration: none; }
  .product-card__image,
  .product-card__placeholder { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity var(--ad-duration-fast) linear; }
  .product-card__image--alternate { position: absolute; inset: 0; opacity: 0; }
  @media (hover: hover) {
    .product-card__media--alternate:hover .product-card__image:not(.product-card__image--alternate) { opacity: 0; }
    .product-card__media--alternate:hover .product-card__image--alternate { opacity: 1; }
  }
  .product-card__index,
  .product-card__badge { position: absolute; z-index: 2; inset-block-start: var(--ad-space-300); font-size: var(--ad-text-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .product-card__index { inset-inline-start: var(--ad-space-300); }
  .product-card__badge { inset-inline-end: var(--ad-space-300); padding: var(--ad-space-50) var(--ad-space-100); background: var(--color-accent); color: var(--ad-color-text-inverse); }
  .product-card__badge--archive { background: var(--ad-color-background-inverse); }
  .product-card__badge--low-supply { border: var(--ad-border-hairline) solid var(--color-accent); background: var(--ad-color-background-primary); color: var(--ad-color-text-primary); }
  .product-card__details { display: flex; padding-block: var(--ad-space-300); align-items: start; justify-content: space-between; gap: var(--ad-space-200); border-block-end: var(--ad-border-hairline) solid color-mix(in srgb, currentcolor 24%, transparent); }
  .product-card__title,
  .product-card__price { margin: 0; font-size: var(--ad-text-body); font-weight: 500; }
  .product-card__title a { text-decoration: none; }
  .product-card__price { margin-block-start: var(--ad-space-50); color: color-mix(in srgb, currentcolor 70%, transparent); }
  .product-card__price s { margin-inline-start: var(--ad-space-100); }
  /* Narrow two-up cards stack the action under the title instead of crowding it. */
  @media (max-width: 29.99rem) {
    .product-card__details { flex-direction: column; gap: var(--ad-space-300); }
    .product-card__details .quick-add__button { min-width: 0; width: 100%; }
    .product-card__details .quick-add { width: 100%; }
  }
{% endstylesheet %}
